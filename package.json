{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"barrel": "bunx --bun barrelsby --delete -l all -d ./src",
		"generate-license-file": "bunx --bun generate-license-file",
		"generate-license-file-ci": "bunx --bun generate-license-file --ci --overwrite --no-spinner",
		"db:generate-client": "bunx --bun prisma generate",
		"db:create-migration": "bunx --bun prisma migrate dev",
		"db:run-migrations": "bunx --bun prisma migrate deploy",
		"db:reset": "bunx --bun prisma migrate reset",
		"db:seed": "bun run prisma/seed.ts",
		"db:reset-and-seed": "bun run db:reset && bun run db:seed",
		"dev": "bun --hot src/server.ts",
		"dev:fresh-db": "bun run db:reset-and-seed && bun run dev",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"test": "bun test --env-file=.env.test",
		"start": "NODE_ENV=production && bun src/server.ts",
		"start:fresh-db": "bun run db:reset-and-seed && bun run start",
		"start:no-env-file": "bun run --no-env-file src/server.ts",
		"build": "bun run build.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.5.0",
		"@prisma/client": "^7.5.0",
		"@vvo/tzdb": "^6.198.0",
		"bun-plugin-tailwind": "^0.1.2",
		"jose": "^6.2.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.13.1",
		"rxjs": "^7.8.2",
		"tailwindcss": "^4.2.2",
		"usehooks-ts": "^3.1.1",
		"winston": "^3.19.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/css": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@eslint/markdown": "^7.5.1",
		"@faker-js/faker": "^10.4.0",
		"@happy-dom/global-registrator": "^20.8.8",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.11",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^10.1.0",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.4.0",
		"typescript-eslint": "^8.57.1"
	}
}